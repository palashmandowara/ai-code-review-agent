# Dashboard authentication: set a long random token before using the UI.
DASHBOARD_TOKEN=
# Use demo for the deterministic authorization fixture, model for real LLM reviews.
REVIEW_MODE=demo
REVIEW_APPROACH=plain
LLM_API_URL=https://api.groq.com/openai/v1/chat/completions
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=
# Leave prices empty until configured; no billing claim should be inferred.
INPUT_USD_PER_MILLION=
OUTPUT_USD_PER_MILLION=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
